import torch
from torch import nn

class CNN1D(nn.Module):
    def __init__(
            self, 
            num_classes=5, 
            filters=16, # kijkt naar 5 meetpunten tegelijk
            input_size=192):
        super().__init__()

        self.conv = nn.Sequential(
            nn.Conv1d(1, filters, kernel_size=5, padding=2),

            nn.ReLU(),
        
            nn.MaxPool1d(2), # halveert het signaal

        )


        # Na poolen:
        # 16 filters × 96 meetpunten = 1536 waarden.
        self.flatten_dim = filters * (input_size // 2)

        self.fc = nn.Sequential(
            nn.Flatten(),
            nn.Linear(
                in_features=self.flatten_dim,
                out_features=num_classes,
            ),
        )

    def forward(self, x):
        # Input uit de dataloader: (batch, 192, 1)
        # Input voor Conv1d:      (batch, 1, 192)
        x = x.permute(0, 2, 1)

        x = self.conv(x)
        return self.fc(x)