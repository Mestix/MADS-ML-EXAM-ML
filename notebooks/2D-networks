import torch
from torch import nn


class CNN2D(nn.Module):
    def __init__(
        self,
        num_classes=5,
        filters=16,
        input_height=12,
        input_width=16,
    ):
        super().__init__()

        # 12 × 16 = 192 ECG-meetpunten
        self.input_height = input_height
        self.input_width = input_width

        self.conv = nn.Sequential(
            nn.Conv2d(
                in_channels=1,
                out_channels=filters,
                kernel_size=3,
                padding=1,
            ),

            nn.ReLU(),

            # Halveert zowel de hoogte als de breedte:
            # 12 × 16 wordt 6 × 8
            nn.MaxPool2d(kernel_size=2),
        )

        # Na het poolen:
        # 16 filters × 6 hoogte × 8 breedte = 768 waarden
        self.flatten_dim = (
            filters
            * (input_height // 2)
            * (input_width // 2)
        )

        self.fc = nn.Sequential(
            nn.Flatten(),

            nn.Linear(
                in_features=self.flatten_dim,
                out_features=num_classes,
            ),
        )

    def forward(self, x):
        # Input uit de dataloader:
        # (batch, 192, 1)

        batch_size = x.shape[0]

        # Verwijder de laatste dimensie:
        # (batch, 192, 1) -> (batch, 192)
        x = x.squeeze(-1)

        # Maak van ieder ECG-signaal een 12 × 16 matrix:
        # (batch, 192) -> (batch, 1, 12, 16)
        x = x.reshape(
            batch_size,
            1,
            self.input_height,
            self.input_width,
        )

        x = self.conv(x)

        return self.fc(x)